# ─── Analitik ────────────────────────────────────────────────────────────────
# Bos birakilirsa hicbir script yuklenmez, hicbir istek gitmez.

# Plausible (onerilen: cerezsiz, KVKK dostu, cerez banneri gerektirmez)
VITE_PLAUSIBLE_DOMAIN=

# Google Analytics 4 (alternatif - cerez banneri gerektirir)
VITE_GA_ID=

# ─── Rezervasyon ─────────────────────────────────────────────────────────────
# cal.com uzerinde acilan etkinligin kullanici/etkinlik kismi.
# Ornek: hypeacademia/deneme-dersi
# Bos birakilirsa iletisim sayfasi yalnizca formu gosterir.
VITE_CAL_LINK=

# ─── Online odeme: PayTR ─────────────────────────────────────────────────────
# Ayrintili kurulum: docs/ODEME-ENTEGRASYONU.md
#
# 1) TARAYICI TARAFI (VITE_ ile baslar, herkes gorebilir)
#    Odeme adimini acar. Asagidaki sunucu anahtarlari tanimlanmadan true
#    yapmayin; musteri hata ekrani gorur.
VITE_PAYMENT_ONLINE=false

# 2) SUNUCU TARAFI (VITE_ YOK - tarayiciya asla gitmez)
#    PayTR Magaza Paneli > BILGI sayfasindan alinir (Ana Kullanici / Teknik
#    Sorumlu gorebilir). Netlify'da: Site configuration > Environment variables
#
#    ⚠️ Bu uc degeri .env dosyasina yazip git'e commit ETMEYIN.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# Test modu. 1 = gercek tahsilat YAPILMAZ (varsayilan).
# Canliya gecerken bilincli olarak 0 yapin.
PAYTR_TEST_MODE=1

# PayTR yanitlarinda ayrintili hata mesaji. Entegrasyon bitince 0 yapilabilir.
PAYTR_DEBUG=1
